# =============================================================================
# 预发布环境配置文件
# 注意：敏感配置应通过环境变量或配置中心注入
# =============================================================================

# 应用基本配置
NODE_ENV=staging
APP_NAME=electrical-rnd-system
APP_PORT=8217
API_PREFIX=/api/v1

# 数据库配置（值通过环境变量注入）
DB_HOST=${DB_HOST:-staging-db-host}
DB_PORT=${DB_PORT:-3306}
DB_NAME=${DB_NAME:-electrical_rnd_staging}
DB_USER=${DB_USER:-staging_user}
DB_PASS=${DB_PASS:-staging_password}
DATABASE_URL=mysql://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}?charset=utf8mb4

# Redis配置
REDIS_HOST=${REDIS_HOST:-staging-redis-host}
REDIS_PORT=${REDIS_PORT:-6379}
REDIS_PASSWORD=${REDIS_PASSWORD:-staging_redis_pass}
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# JWT配置（密钥通过环境变量注入）
JWT_SECRET=${JWT_SECRET:-staging_jwt_secret_ChangeMe}
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# 日志配置
LOG_LEVEL=info
LOG_FILE=/var/log/app/app.log
LOG_FORMAT=json

# 文件上传配置（使用云存储或共享存储）
UPLOAD_DIR=/data/shared/uploads
MAX_FILE_SIZE=50MB
ALLOWED_FILE_TYPES=.pdf,.dwg,.dxf,.step,.igs,.stp,.png,.jpg,.jpeg

# 服务URL配置
FRONTEND_URL=https://staging.yourcompany.com
BACKEND_URL=https://api-staging.yourcompany.com

# 数据库版本控制（Flyway）
FLYWAY_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?useSSL=false&serverTimezone=Asia/Shanghai
FLYWAY_USER=${DB_USER}
FLYWAY_PASSWORD=${DB_PASS}

# 调试配置
DEBUG=false
ENABLE_SWAGGER=true
ENABLE_PROFILING=false
