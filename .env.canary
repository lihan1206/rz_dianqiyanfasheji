# =============================================================================
# 灰度发布环境配置文件
# 用于金丝雀发布时的灰度版本专用配置
# =============================================================================

# 应用基本配置
NODE_ENV=production
APP_NAME=electrical-rnd-system-canary
APP_PORT=8217
API_PREFIX=/api/v1

# 灰度版本标识
SERVICE_VERSION=canary
CANARY_ENABLED=true

# 数据库配置（与稳定版共用或使用独立库）
DB_HOST=${DB_HOST}
DB_PORT=${DB_PORT:-3306}
DB_NAME=${DB_NAME}
DB_USER=${DB_USER}
DB_PASS=${DB_PASSWORD}
DATABASE_URL=mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?charset=utf8mb4

# Redis配置（可与稳定版共用）
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=${REDIS_PORT:-6379}
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/1

# JWT配置（与稳定版相同以保证会话兼容）
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRE=12h
JWT_REFRESH_EXPIRE=3d

# 日志配置（灰度版本日志独立目录）
LOG_LEVEL=debug
LOG_FILE=/var/log/app/canary/app.log
LOG_FORMAT=json

# 文件上传配置（与稳定版共享存储）
UPLOAD_DIR=/data/oss_uploads
MAX_FILE_SIZE=100MB

# 灰度发布特征开关
FEATURE_FLAG_NEW_BOM=true
FEATURE_FLAG_ADVANCED_REPORT=true
FEATURE_FLAG_CANARY_ONLY=true

# 监控配置（灰度版本指标独立标识）
METRICS_PREFIX=canary_
TRACING_ENABLED=true
