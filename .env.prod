# =============================================================================
# 生产环境配置文件
# 注意：此文件仅作为模板，实际生产环境敏感配置应通过
# Kubernetes Secret、HashiCorp Vault或配置中心注入
# =============================================================================

# 应用基本配置
NODE_ENV=production
APP_NAME=electrical-rnd-system
APP_PORT=8217
API_PREFIX=/api/v1

# 数据库配置（所有敏感值通过环境变量注入）
DB_HOST=${DB_HOST}
DB_PORT=${DB_PORT:-3306}
DB_NAME=${DB_NAME}
DB_USER=${DB_USER}
DB_PASS=${DB_PASSWORD}
DATABASE_URL=mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?charset=utf8mb4

# Redis配置
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=${REDIS_PORT:-6379}
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# JWT配置（密钥通过安全渠道注入）
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRE=12h
JWT_REFRESH_EXPIRE=3d

# 日志配置（JSON格式，输出到stdout便于日志收集）
LOG_LEVEL=warn
LOG_FILE=/dev/stdout
LOG_FORMAT=json

# 文件上传配置（生产环境应使用对象存储服务如OSS/S3）
UPLOAD_DIR=/data/oss_uploads
MAX_FILE_SIZE=100MB
ALLOWED_FILE_TYPES=.pdf,.dwg,.dxf,.step,.igs,.stp,.png,.jpg,.jpeg

# 服务URL配置
FRONTEND_URL=https://yourcompany.com
BACKEND_URL=https://api.yourcompany.com

# 数据库版本控制（Flyway）
FLYWAY_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?useSSL=true&serverTimezone=Asia/Shanghai
FLYWAY_USER=${DB_USER}
FLYWAY_PASSWORD=${DB_PASSWORD}

# 安全配置
DEBUG=false
ENABLE_SWAGGER=false
ENABLE_PROFILING=false
HTTPS_ONLY=true
