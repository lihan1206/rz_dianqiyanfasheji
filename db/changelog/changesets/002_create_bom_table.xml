<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002" author="dev-team" context="dev,staging,prod">
        <comment>创建BOM表 - BOM管理服务核心表</comment>
        
        <createTable tableName="bom_headers">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="bom_code" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="project_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="VARCHAR(20)" defaultValue="1.0">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="DRAFT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="${now}"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="${now}"/>
        </createTable>
        
        <createTable tableName="bom_items">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="bom_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="parent_item_id" type="BIGINT"/>
            <column name="component_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="DECIMAL(15,4)" defaultValue="1">
                <constraints nullable="false"/>
            </column>
            <column name="level" type="INT" defaultValue="1"/>
            <column name="sort_order" type="INT" defaultValue="0"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="${now}"/>
        </createTable>
        
        <addForeignKeyConstraint 
            baseTableName="bom_headers" 
            baseColumnNames="project_id"
            constraintName="fk_bom_project"
            referencedTableName="projects"
            referencedColumnNames="id"
            onDelete="CASCADE"/>
            
        <addForeignKeyConstraint 
            baseTableName="bom_items" 
            baseColumnNames="bom_id"
            constraintName="fk_bom_item_header"
            referencedTableName="bom_headers"
            referencedColumnNames="id"
            onDelete="CASCADE"/>
        
        <rollback>
            <dropTable tableName="bom_items"/>
            <dropTable tableName="bom_headers"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
