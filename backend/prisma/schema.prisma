generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Role {
  ADMIN
  ENGINEER
  MANAGER
  REVIEWER
  PURCHASER
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  passwordHash  String
  name          String
  role          Role
  email         String?
  phone         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  managedProjects Project[]    @relation("ProjectManager")
  projectMembers ProjectMember[]
  drawings      Drawing[]
  bomsCreated   Bom[]
  reviews       DesignReview[] @relation("Reviewer")
  reviewSubmits DesignReview[] @relation("Submitter")
}

model Project {
  id          Int             @id @default(autoincrement())
  name        String
  code        String          @unique
  description String?
  status      ProjectStatus   @default(PLANNING)
  startDate   DateTime?
  endDate     DateTime?
  managerId   Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  manager     User            @relation("ProjectManager", fields: [managerId], references: [id])
  members     ProjectMember[]
  drawings    Drawing[]
  boms        Bom[]
}

model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int
  userId    Int
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Drawing {
  id          Int            @id @default(autoincrement())
  name        String
  filePath    String
  fileType    String
  version     Int            @default(1)
  tags        String?
  projectId   Int
  uploadedById Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy  User           @relation(fields: [uploadedById], references: [id])
  reviews     DesignReview[]
  bomLinks    BomDrawing[]
}

model Component {
  id            Int      @id @default(autoincrement())
  name          String
  partNumber    String   @unique
  category      String
  specification String?
  packageType   String?
  voltageRating Decimal? @db.Decimal(10, 2)
  powerRating   Decimal? @db.Decimal(10, 2)
  price         Decimal? @db.Decimal(10, 2)
  manufacturer  String?
  datasheetUrl  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bomItems      BomItem[]
}

model Bom {
  id          Int         @id @default(autoincrement())
  name        String
  version     Int         @default(1)
  stage       String
  projectId   Int
  createdById Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User        @relation(fields: [createdById], references: [id])
  items       BomItem[]
  drawings    BomDrawing[]
}

model BomItem {
  id          Int      @id @default(autoincrement())
  bomId       Int
  componentId Int
  quantity    Int
  unitPrice   Decimal? @db.Decimal(10, 2)
  supplier    String?
  notes       String?
  createdAt   DateTime @default(now())
  bom         Bom      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  component   Component @relation(fields: [componentId], references: [id])

  @@unique([bomId, componentId])
}

model BomDrawing {
  id        Int      @id @default(autoincrement())
  bomId     Int
  drawingId Int
  createdAt DateTime @default(now())
  bom       Bom      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  drawing   Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  @@unique([bomId, drawingId])
}

model DesignReview {
  id          Int          @id @default(autoincrement())
  drawingId   Int
  reviewerId  Int
  submitterId Int
  status      ReviewStatus @default(PENDING)
  comment     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  drawing     Drawing      @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  reviewer    User         @relation("Reviewer", fields: [reviewerId], references: [id])
  submitter   User         @relation("Submitter", fields: [submitterId], references: [id])
}
