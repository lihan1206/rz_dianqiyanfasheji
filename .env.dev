# =============================================================================
# 开发环境配置文件
# 注意：此文件可提交到代码库，但请勿包含敏感密码或密钥
# =============================================================================

# 应用基本配置
NODE_ENV=development
APP_NAME=electrical-rnd-system
APP_PORT=8217
API_PREFIX=/api/v1

# 数据库配置
DB_HOST=localhost
DB_PORT=33367
DB_NAME=electrical_rnd
DB_USER=root
DB_PASS=root
DATABASE_URL=mysql://root:root@localhost:33367/electrical_rnd?charset=utf8mb4

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_pass
REDIS_URL=redis://:redis_dev_pass@localhost:6379/0

# JWT配置
JWT_SECRET=dev_jwt_secret_2026_ChangeMeInProduction
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# 日志配置
LOG_LEVEL=debug
LOG_FILE=./logs/app.log
LOG_FORMAT=dev

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB
ALLOWED_FILE_TYPES=.pdf,.dwg,.dxf,.step,.igs,.stp,.png,.jpg,.jpeg

# 服务URL配置（开发环境）
FRONTEND_URL=http://localhost:31267
BACKEND_URL=http://localhost:18267

# 数据库版本控制（Flyway）
FLYWAY_URL=jdbc:mysql://localhost:33367/electrical_rnd?useSSL=false&serverTimezone=Asia/Shanghai
FLYWAY_USER=root
FLYWAY_PASSWORD=root

# 调试配置
DEBUG=true
ENABLE_SWAGGER=true
ENABLE_PROFILING=true
