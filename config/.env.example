# 应用配置
APP_NAME=project-service
APP_ENV=dev
APP_PORT=5000
DEBUG=true

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=project_db
DB_USER=dbuser
DB_PASSWORD=changeme

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT配置
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRE_HOURS=24

# 外部服务
API_GATEWAY_URL=http://localhost:8080
COMPONENT_SERVICE_URL=http://localhost:5002

# 日志级别
LOG_LEVEL=INFO
